{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mzantsi-vibes",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "PUBLISH",
    "binding": "ASSETS",
    // Only the API and the review links need the Worker. Everything else is served
    // straight from the assets, which is free and unmetered (every request that
    // runs the Worker counts against the free plan's 100k a day).
    "run_worker_first": ["/api/*", "/action"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // No public preview URL per version. Branch builds upload a version of this
  // Worker, and each used to get a reachable *.workers.dev URL that runs the
  // branch's code with the production secrets. The live site is unaffected.
  "preview_urls": false,

  // 06:00 UTC = 08:00 SAST -> morning review digest
  // 16:00 UTC = 18:00 SAST -> batch merge of everything approved
  // 05:00 UTC Mondays (MON, not 1: Cloudflare counts 1 as Sunday) = 07:00 SAST -> weekly opportunity digest (GitHub issue)
  "triggers": {
    "crons": [
      "0 6 * * *",
      "0 16 * * *",
      "0 5 * * MON"
    ]
  },

  // Non-secret settings only. Everything sensitive is a Worker secret:
  //   wrangler secret put GITHUB_APP_ID
  //   wrangler secret put GITHUB_APP_PRIVATE_KEY
  //   wrangler secret put HMAC_SECRET
  //   wrangler secret put RESEND_API_KEY
  //   wrangler secret put REVIEWER_EMAIL
  //   wrangler secret put TAVILY_API_KEY
  "vars": {
    "REPO_OWNER": "realtimshady16",
    "REPO_NAME": "mzantsi-vibes",
    "REVIEWER_NAME": "Tim",
    "BASE_URL": "https://mzantsivibes.co.za",
    "EMAIL_FROM": "Mzantsi Vibes <onboarding@resend.dev>",
    "BRANCH_PREFIX": "contribute",
    "TOKEN_TTL_HOURS": "72",
    "RATE_LIMIT_MAX": "5"
  }
}
