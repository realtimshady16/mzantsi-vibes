# Local development secrets for `wrangler dev`.
#
# Copy this file to `.dev.vars` and fill it in. `.dev.vars` is gitignored —
# never commit real values. In production use `wrangler secret put <NAME>`
# instead, which stores the value encrypted and never touches the repo.
#
#   cp .dev.vars.example .dev.vars

# The GitHub App the system runs as (see CONTRIBUTE_SETUP.md). There is no bot
# user account. The key is the .pem GitHub gave you; for .dev.vars put it on ONE
# line with literal \n between lines. In production use `wrangler secret put`,
# which takes the .pem as it is.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional, for scripts/run-opportunities.mjs --post only: a token to post the
# opportunity issue as yourself, e.g. GITHUB_TOKEN=$(gh auth token). The Worker
# never reads this.
GITHUB_TOKEN=

# Signs the Approve/Reject links in the digest email. Any long random string.
#   openssl rand -hex 32
HMAC_SECRET=

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where the daily digest is sent.
REVIEWER_EMAIL=

# Tavily API key for the weekly opportunity digest — https://app.tavily.com
# Optional: without it only the opportunity digest is disabled.
TAVILY_API_KEY=
